# Create a local .env file and provide the real value there.
# Never commit the local .env file.
API_KEY=your_gemini_api_key

# Supabase project settings (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_backend_secret_key

# Public values used by the Vite frontend
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Used later to encrypt each user's Google refresh token at rest
TOKEN_ENCRYPTION_KEY=generate_a_random_fernet_key

# Google Web OAuth client used by Supabase and backend token refresh
GOOGLE_CLIENT_ID=your_web_oauth_client_id
GOOGLE_CLIENT_SECRET=your_web_oauth_client_secret

# Production website and API addresses
FRONTEND_URL=https://your-frontend-domain.example
VITE_API_URL=https://your-backend-domain.example
